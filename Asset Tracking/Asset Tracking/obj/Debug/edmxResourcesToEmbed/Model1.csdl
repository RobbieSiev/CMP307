<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="dbModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityContainer Name="dbEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="assets" EntityType="dbModel.asset" />
    <EntitySet Name="employees" EntityType="dbModel.employee" />
    <EntitySet Name="hardwares" EntityType="dbModel.hardware" />
    <AssociationSet Name="FK_asset_employee" Association="dbModel.FK_asset_employee">
      <End Role="employee" EntitySet="employees" />
      <End Role="asset" EntitySet="assets" />
    </AssociationSet>
  </EntityContainer>
  <EntityType Name="asset">
    <Key>
      <PropertyRef Name="id" />
    </Key>
    <Property Name="id" Type="Int32" Nullable="false" />
    <Property Name="name" Type="String" Nullable="false" MaxLength="16" FixedLength="false" Unicode="false" />
    <Property Name="purchaseDate" Type="DateTime" Precision="0" />
    <Property Name="notes" Type="String" MaxLength="255" FixedLength="false" Unicode="false" />
    <Property Name="eid" Type="Int32" Nullable="false" />
    <NavigationProperty Name="employee" Relationship="dbModel.FK_asset_employee" FromRole="asset" ToRole="employee" />
  </EntityType>
  <EntityType Name="employee">
    <Key>
      <PropertyRef Name="eid" />
    </Key>
    <Property Name="fname" Type="String" Nullable="false" MaxLength="32" FixedLength="true" Unicode="true" />
    <Property Name="lname" Type="String" Nullable="false" MaxLength="32" FixedLength="true" Unicode="true" />
    <Property Name="email" Type="String" Nullable="false" MaxLength="64" FixedLength="true" Unicode="true" />
    <Property Name="eid" Type="Int32" Nullable="false" />
    <Property Name="dept" Type="String" Nullable="false" MaxLength="16" FixedLength="false" Unicode="false" />
    <NavigationProperty Name="assets" Relationship="dbModel.FK_asset_employee" FromRole="employee" ToRole="asset" />
  </EntityType>
  <EntityType Name="hardware">
    <Key>
      <PropertyRef Name="deviceId" />
    </Key>
    <Property Name="systemName" Type="String" Nullable="false" MaxLength="64" FixedLength="true" Unicode="true" />
    <Property Name="model" Type="String" Nullable="false" MaxLength="64" FixedLength="true" Unicode="true" />
    <Property Name="manufacturer" Type="String" Nullable="false" MaxLength="64" FixedLength="true" Unicode="true" />
    <Property Name="type" Type="String" Nullable="false" MaxLength="32" FixedLength="true" Unicode="true" />
    <Property Name="ip" Type="String" Nullable="false" MaxLength="16" FixedLength="true" Unicode="true" />
    <Property Name="deviceId" Type="Int32" Nullable="false" />
  </EntityType>
  <Association Name="FK_asset_employee">
    <End Type="dbModel.employee" Role="employee" Multiplicity="1" />
    <End Type="dbModel.asset" Role="asset" Multiplicity="*" />
    <ReferentialConstraint>
      <Principal Role="employee">
        <PropertyRef Name="eid" />
      </Principal>
      <Dependent Role="asset">
        <PropertyRef Name="eid" />
      </Dependent>
    </ReferentialConstraint>
  </Association>
</Schema>