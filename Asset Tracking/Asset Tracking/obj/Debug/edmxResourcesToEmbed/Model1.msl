<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="dbModelStoreContainer" CdmEntityContainer="dbEntities">
    <EntitySetMapping Name="assets">
      <EntityTypeMapping TypeName="dbModel.asset">
        <MappingFragment StoreEntitySet="asset">
          <ScalarProperty Name="eid" ColumnName="eid" />
          <ScalarProperty Name="notes" ColumnName="notes" />
          <ScalarProperty Name="purchaseDate" ColumnName="purchaseDate" />
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="id" ColumnName="id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="employees">
      <EntityTypeMapping TypeName="dbModel.employee">
        <MappingFragment StoreEntitySet="employee">
          <ScalarProperty Name="dept" ColumnName="dept" />
          <ScalarProperty Name="eid" ColumnName="eid" />
          <ScalarProperty Name="email" ColumnName="email" />
          <ScalarProperty Name="lname" ColumnName="lname" />
          <ScalarProperty Name="fname" ColumnName="fname" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="hardwares">
      <EntityTypeMapping TypeName="dbModel.hardware">
        <MappingFragment StoreEntitySet="hardware">
          <ScalarProperty Name="deviceId" ColumnName="deviceId" />
          <ScalarProperty Name="ip" ColumnName="ip" />
          <ScalarProperty Name="type" ColumnName="type" />
          <ScalarProperty Name="manufacturer" ColumnName="manufacturer" />
          <ScalarProperty Name="model" ColumnName="model" />
          <ScalarProperty Name="systemName" ColumnName="systemName" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>